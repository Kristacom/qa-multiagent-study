# Режим работы языковой модели: "mock" (по умолчанию, без ключей), "ollama", "openai", "gemini"
QA_LLM_MODE=mock
QA_LLM_MODEL=mock-gpt-4o

# Ключи LLM (заполнять только при QA_LLM_MODE != mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Целевая TMS по умолчанию: "testomat", "local"
QA_TMS_TARGET=testomat

# Настройки Testomat.io TMS (https://app.testomat.io)
TESTOMATIO_URL=https://app.testomat.io
TESTOMATIO=tstmt_your_project_token_here
TESTOMATIO_API_KEY=tstmt_your_project_token_here
TESTOMATIO_PROJECT_ID=shop-qa
TESTOMATIO_PROJECT=shop-qa

# Настройки Jira REST API (опционально)
JIRA_URL=https://jira.company.internal
JIRA_API_TOKEN=

# Настройки Confluence REST API (опционально)
CONFLUENCE_URL=https://confluence.company.internal
CONFLUENCE_API_TOKEN=
