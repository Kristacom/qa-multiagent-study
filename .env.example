# Режим работы языковой модели: "mock" (по умолчанию, без ключей), "ollama", "openai", "gemini"
QA_LLM_MODE=mock
QA_LLM_MODEL=mock-gpt-4o

# Ключи LLM (заполнять только при QA_LLM_MODE != mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Целевая TMS по умолчанию: "test_it", "local"
QA_TMS_TARGET=test_it

# Настройки Test IT (при использовании реального Test IT)
TESTIT_URL=https://testit.company.internal
TESTIT_PRIVATE_TOKEN=
TESTIT_PROJECT_ID=study-project-id

# Настройки Jira REST API (опционально)
JIRA_URL=https://jira.company.internal
JIRA_API_TOKEN=

# Настройки Confluence REST API (опционально)
CONFLUENCE_URL=https://confluence.company.internal
CONFLUENCE_API_TOKEN=
