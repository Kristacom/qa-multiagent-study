{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],

  // Модель по умолчанию от Cloud.ru
  "model": "cloudru/deepseek-ai/DeepSeek-V4.1-Flash",

  // Провайдеры моделей
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloud.ru",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash"
        },
        "google/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google",
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        }
      }
    }
  },

  // Подключение MCP серверов (Jira, Confluence, Testomat.io, Gemini)
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["npx", "-y", "mcp-jira-cloud"],
      "enabled": true,
      "environment": {
        "JIRA_BASE_URL": "https://kristapro.atlassian.net",
        "JIRA_EMAIL": "krista.pro@yandex.ru",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "confluence": {
      "type": "local",
      "command": ["npx", "-y", "@aashari/mcp-server-atlassian-confluence"],
      "enabled": true,
      "environment": {
        "ATLASSIAN_SITE_NAME": "kristapro",
        "ATLASSIAN_USER_EMAIL": "krista.pro@yandex.ru",
        "ATLASSIAN_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      }
    },
    "testomat": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@testomatio/mcp"
      ],
      "enabled": true,
      "environment": {
        "TESTOMATIO_PROJECT_TOKEN": "{env:TESTOMATIO}",
        "TESTOMATIO_API_TOKEN": "{env:TESTOMATIO}",
        "TESTOMATIO_PROJECT_ID": "{env:TESTOMATIO_PROJECT_ID}"
      }
    },
    "gemini": {
      "type": "local",
      "command": ["npx", "-y", "@houtini/gemini-mcp"],
      "enabled": true,
      "environment": {
        "GEMINI_API_KEY": "{env:GEMINI_API_KEY}",
        "GEMINI_MODEL": "gemini-3.8-flash"
      }
    }
  },
  "disabled_providers": []
}
