{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],

  // Модель по умолчанию от Cloud.ru
  "model": "cloudru/deepseek-ai/DeepSeek-V4.1-Flash",

  // Провайдер Cloud.ru (OpenAI-совместимый API с вашим токеном)
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloud.ru",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek V4 Pro"
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen 3.5 397B"
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen 3 Coder Next"
        },
        "openai/gpt-5": {
          "name": "GPT-5"
        },
        "anthropic/claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5"
        }
      }
    }
  },

  // Подключение MCP серверов (Jira, Confluence)
  "mcp": {
    "jira": {
      "type": "local",
      "command": ["npx", "-y", "mcp-jira-cloud"],
      "enabled": true,
      "environment": {
        "JIRA_BASE_URL": "https://kristapro.atlassian.net",
        "JIRA_EMAIL": "krista.pro@yandex.ru",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "confluence": {
      "type": "local",
      "command": ["npx", "-y", "@aashari/mcp-server-atlassian-confluence"],
      "enabled": true,
      "environment": {
        "ATLASSIAN_SITE_NAME": "kristapro",
        "ATLASSIAN_USER_EMAIL": "krista.pro@yandex.ru",
        "ATLASSIAN_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      }
    }
  },
  "disabled_providers": []
}
